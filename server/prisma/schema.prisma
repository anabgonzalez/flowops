// FlowOps data model. See docs/PRODUCT_PLAN.md for the full feature plan.
// This file currently covers Phase 1 (core job lifecycle): CRM, Job/
// Appointment scheduling, Pricebook, Estimates, Invoicing & Payments.
//
// Money is stored as integer cents (e.g. priceCents) to avoid floating
// point rounding errors; convert to dollars for display only.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CSR
  DISPATCHER
  TECHNICIAN
  SALES_REP
  OWNER
}

enum CustomerType {
  RESIDENTIAL
  COMMERCIAL
}

enum JobStatus {
  UNSCHEDULED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELED
  ON_HOLD
}

enum JobPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AppointmentStatus {
  SCHEDULED
  DISPATCHED
  EN_ROUTE
  ON_SITE
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum PricebookItemType {
  SERVICE
  MATERIAL
  EQUIPMENT
  OTHER
}

enum PricingMethod {
  FLAT_RATE
  TIME_AND_MATERIALS
}

enum EstimateStatus {
  DRAFT
  PRESENTED
  APPROVED
  DECLINED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  CHECK
  CARD
  ACH
  FINANCING
}

enum TagCategory {
  JOB
  CUSTOMER
  LOCATION
}

enum ContactRole {
  TENANT
  PROPERTY_MANAGER
  OTHER
}

model User {
  id    String @id @default(cuid())
  name  String
  email String @unique
  phone String?
  role  Role

  // Null until someone (an admin, or the one-time bootstrap flow) sets a
  // password - a User row can exist as a directory entry (tech roster)
  // before it's ever a login-capable account.
  passwordHash String?

  // HR/dispatch profile - all optional since not every role (e.g. an
  // office-only ADMIN) needs a truck or a pay rate on file.
  title            String?
  truckNumber      String?
  homeAddressLine1 String?
  homeCity         String?
  homeState        String?
  homePostalCode   String?

  // Pay: any subset of these can be set at once (e.g. hourly + commission),
  // so this is deliberately not a single "pay type" enum - which fields are
  // non-null is what determines how someone is paid.
  hourlyRateCents    Int?
  annualSalaryCents  Int?
  commissionPercent  Float?

  // Sparse deltas from that user's RolePermissions default - e.g.
  // { "manage_technicians": true } to grant one extra permission to an
  // otherwise-standard TECHNICIAN. Absent key = inherit the role default.
  permissionOverrides Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]
}

// Default permission set for each Role, editable in Settings. Individual
// users can still deviate from their role's defaults via
// User.permissionOverrides.
model RolePermissions {
  id          String   @id @default(cuid())
  role        Role     @unique
  permissions Json
  updatedAt   DateTime @updatedAt
}

model Customer {
  id        String       @id @default(cuid())
  name      String
  email     String?
  phone     String?
  type      CustomerType @default(RESIDENTIAL)
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  locations Location[]
  tags      Tag[]
}

// The Customer on a Location is the billing/approval party (e.g. a
// landlord). LocationContact is a separate person at the property who
// coordinates scheduling/on-site access (e.g. a tenant) - they don't pay
// or approve anything, they're just who the field team talks to.
model Location {
  id           String   @id @default(cuid())
  customerId   String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobs     Job[]
  tags     Tag[]
  contacts LocationContact[]
}

model LocationContact {
  id         String      @id @default(cuid())
  locationId String
  name       String
  email      String?
  phone      String?
  role       ContactRole @default(TENANT)
  isPrimary  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
}

model JobType {
  id              String      @id @default(cuid())
  name            String      @unique
  defaultPriority JobPriority @default(NORMAL)
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  jobs Job[]
}

model Tag {
  id        String      @id @default(cuid())
  name      String      @unique
  color     String
  category  TagCategory @default(JOB)
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  jobs      Job[]
  customers Customer[]
  locations Location[]
}

// A reusable scheduling window (e.g. "Morning", "8-10 AM") so dispatchers
// pick a time block instead of typing exact start/end times. startTime/
// endTime are "HH:mm" 24-hour strings, combined with a chosen date on the
// client to produce the actual appointment start/end.
model Timeframe {
  id        String   @id @default(cuid())
  name      String   @unique
  startTime String
  endTime   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id         String      @id @default(cuid())
  locationId String
  jobTypeId  String
  status     JobStatus   @default(UNSCHEDULED)
  priority   JobPriority @default(NORMAL)
  summary    String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  location     Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  jobType      JobType       @relation(fields: [jobTypeId], references: [id])
  tags         Tag[]
  appointments Appointment[]
  estimates    Estimate[]
  invoices     Invoice[]
}

model Appointment {
  id           String            @id @default(cuid())
  jobId        String
  technicianId String?
  start        DateTime
  end          DateTime
  status       AppointmentStatus @default(SCHEDULED)
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  job        Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  technician User? @relation(fields: [technicianId], references: [id])
}

// Categories/subcategories are one flat self-referential tree (parentId
// null = top-level category). Applies across all item types - e.g.
// "HVAC > Repair" can hold services, materials, and equipment alike.
model PricebookCategory {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   PricebookCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children PricebookCategory[] @relation("CategoryHierarchy")
  items    PricebookItem[]

  @@unique([name, parentId])
}

model PricebookItem {
  id          String            @id @default(cuid())
  code        String            @unique
  name        String
  description String?
  type        PricebookItemType
  categoryId  String?

  // Pricing
  costCents        Int
  priceCents       Int
  memberPriceCents Int?
  addOnPriceCents  Int?
  markupPercent    Float?

  // Flat rate bundles labor+materials+overhead into one price. Time &
  // materials bills a separate hourly labor rate plus materials at cost -
  // laborRateCents only applies when pricingMethod is TIME_AND_MATERIALS.
  pricingMethod  PricingMethod @default(FLAT_RATE)
  laborRateCents Int?

  estimatedDurationMinutes Int?
  unitOfMeasure            String  @default("each")
  taxable                  Boolean @default(true)
  nonDiscountable          Boolean @default(false)

  warrantyDurationMonths Int?
  warrantyTerms          String?

  vendorName       String?
  vendorPartNumber String?
  imageUrl         String?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category          PricebookCategory?       @relation(fields: [categoryId], references: [id])
  estimateLineItems EstimateLineItem[]
  invoiceLineItems  InvoiceLineItem[]
  components        PricebookItemComponent[] @relation("ParentItem")
  usedInComponents  PricebookItemComponent[] @relation("ComponentItem")
}

// Default bill-of-materials for a Service/Equipment item - e.g. "AC
// Install" typically needs a condenser, line set, and disconnect. Shown
// as reference info on the pricebook item; quantities on an actual
// estimate/invoice are still entered per job, not auto-expanded from this.
model PricebookItemComponent {
  id              String @id @default(cuid())
  parentItemId    String
  componentItemId String
  quantity        Int    @default(1)

  parentItem    PricebookItem @relation("ParentItem", fields: [parentItemId], references: [id], onDelete: Cascade)
  componentItem PricebookItem @relation("ComponentItem", fields: [componentItemId], references: [id], onDelete: Cascade)

  @@unique([parentItemId, componentItemId])
}

model Estimate {
  id            String         @id @default(cuid())
  jobId         String
  name          String
  status        EstimateStatus @default(DRAFT)
  subtotalCents Int            @default(0)
  taxCents      Int            @default(0)
  totalCents    Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  job       Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  lineItems EstimateLineItem[]
  invoice   Invoice?
}

model EstimateLineItem {
  id              String  @id @default(cuid())
  estimateId      String
  pricebookItemId String?
  description     String
  quantity        Int     @default(1)
  unitPriceCents  Int
  totalCents      Int

  estimate      Estimate       @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  pricebookItem PricebookItem? @relation(fields: [pricebookItemId], references: [id])
}

model Invoice {
  id            String        @id @default(cuid())
  jobId         String
  estimateId    String?       @unique
  invoiceNumber String        @unique
  status        InvoiceStatus @default(DRAFT)
  subtotalCents Int           @default(0)
  taxCents      Int           @default(0)
  totalCents    Int           @default(0)
  balanceCents  Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  job       Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  estimate  Estimate?         @relation(fields: [estimateId], references: [id])
  lineItems InvoiceLineItem[]
  payments  Payment[]
}

model InvoiceLineItem {
  id              String  @id @default(cuid())
  invoiceId       String
  pricebookItemId String?
  description     String
  quantity        Int     @default(1)
  unitPriceCents  Int
  totalCents      Int

  invoice       Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  pricebookItem PricebookItem? @relation(fields: [pricebookItemId], references: [id])
}

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  amountCents Int
  method      PaymentMethod
  paidAt      DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}
